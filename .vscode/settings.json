{
  // bun.lock memakai format JSONC (boleh trailing comma) — jangan divalidasi sebagai JSON ketat.
  // Tanpa ini VS Code menampilkan 5 "problems" palsu padahal `bun install` baik-baik saja.
  "files.associations": {
    "bun.lock": "jsonc"
  },
  // Koneksi database untuk extension SQLTools (tanpa Docker).
  // Password diambil dari variabel environment agar tidak tersimpan di git.
  // Isi sekali di terminal VS Code:  $env:DB_PASSWORD="isi_password_db"
  "sqltools.connections": [
    {
      "name": "toko-alat-musik (lokal)",
      "driver": "PostgreSQL",
      "previewLimit": 50,
      "server": "localhost",
      "port": 5433,
      "database": "toko_alat_musik",
      "username": "toko_user",
      "password": "${env:DB_PASSWORD}",
      "pgOptions": {
        "ssl": false
      }
    }
  ]
}
